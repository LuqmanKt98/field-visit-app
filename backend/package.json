{
  "name": "field-visit-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API for the field visit management app: task lookup, S3 photo/video upload, admin auth.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "provision-s3": "tsx src/scripts/provisionS3.ts",
    "verify-s3": "tsx src/scripts/verifyS3.ts",
    "reset-demo": "tsx src/scripts/resetDemo.ts",
    "set-task-location": "tsx src/scripts/setTaskLocation.ts",
    "list-task-media": "tsx src/scripts/listTaskMedia.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/routes/media.integration.test.ts",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.687.0",
    "@aws-sdk/s3-request-presigner": "^3.1109.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}

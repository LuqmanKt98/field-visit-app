# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/field_visit

# Used to sign admin JWT session tokens -- use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# AWS S3 (the IAM user needs full S3 permissions -- the app creates the bucket,
# sets its public-access-block and CORS policy, and issues presigned upload URLs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=field-visit-media
# How long a presigned upload URL stays valid, in seconds.
# 15 minutes, not 5: a rep on a weak mobile connection can still be uploading the
# video when a shorter window expires, which fails the upload mid-transfer.
S3_PRESIGNED_URL_EXPIRY_SECONDS=900

# Field visit business rules
CAMERA_UNLOCK_DISTANCE_METERS=100
REQUIRED_PHOTO_COUNT=10
REQUIRED_VIDEO_COUNT=1
ENFORCE_SERVER_SIDE_DISTANCE_CHECK=true

# Comma-separated list of allowed frontend origins (used for both the API's CORS
# policy and the S3 bucket's CORS policy, since the browser uploads directly to S3).
# Set to your deployed frontend URL(s) in production, e.g.:
# https://myfieldvisitapp.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/field_visit

# Used to sign admin JWT session tokens -- use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# AWS S3 (IAM user needs: s3:CreateBucket, s3:HeadBucket, s3:PutObject,
# s3:PutBucketPublicAccessBlock on the target bucket/account)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=field-visit-media

# Field visit business rules
CAMERA_UNLOCK_DISTANCE_METERS=100
REQUIRED_PHOTO_COUNT=10
REQUIRED_VIDEO_COUNT=1
ENFORCE_SERVER_SIDE_DISTANCE_CHECK=true

# Comma-separated list is NOT supported by the current cors() call (single origin/string only);
# set to your deployed frontend URL in production, e.g. https://myfieldvisitapp.com
CORS_ORIGIN=*

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  // Build config: emits dist/server.js for a long-running Node host, so rootDir stays
  // "src". The Vercel entrypoint in api/ is compiled by Vercel itself and is
  // type-checked via tsconfig.check.json instead.
  "include": ["src"]
}

# Copy to .env.local and fill in real values.

VITE_API_BASE_URL=http://localhost:4000/api
VITE_GOOGLE_MAPS_API_KEY=

# Mirrors the backend's fieldVisit config -- purely cosmetic here since the
# server enforces the real rule; keep the two in sync when tuning.
VITE_CAMERA_UNLOCK_DISTANCE_METERS=100
VITE_REQUIRED_PHOTO_COUNT=10
VITE_REQUIRED_VIDEO_COUNT=1
